{
  "manifest_version": 3,
  "name": "Flowkit ElevenLabs Bridge",
  "version": "1.0.22",
  "description": "Send queued text to your ElevenLabs TTS page and save generated audio in Flowkit Studio.",
  "permissions": ["storage", "alarms", "tabs", "sidePanel", "scripting", "downloads"],
  "host_permissions": ["https://elevenlabs.io/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://elevenlabs.io/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "Open Flowkit ElevenLabs side panel"},
  "side_panel": {"default_path": "side_panel.html"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "minimum_chrome_version": "116"
}
