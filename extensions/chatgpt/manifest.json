{
  "manifest_version": 3,
  "name": "Flowkit ChatGPT Gateway",
  "version": "1.12.3",
  "description": "Local API gateway for ChatGPT \u2014 automates your logged-in session",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Flowkit ChatGPT side panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "minimum_chrome_version": "116"
}
